# Set these as environment variables (the app does not read a .env file). All optional; values shown are the defaults.
ARXIV_RAG_DATA_DIR=data
ARXIV_RAG_RESULTS_DIR=results
ARXIV_RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Any OpenAI-compatible chat endpoint. Default: local Ollama (`ollama pull qwen2.5:7b`).
ARXIV_RAG_LLM_BASE_URL=http://localhost:11434/v1
ARXIV_RAG_LLM_MODEL=qwen2.5:7b
# ARXIV_RAG_LLM_API_KEY=
